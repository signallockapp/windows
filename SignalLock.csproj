<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SignalLock</RootNamespace>
    <AssemblyName>SignalLock</AssemblyName>
    <ApplicationManifest>App.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <ApplicationIcon>SignalLock.ico</ApplicationIcon>
    <NeutralLanguage>en</NeutralLanguage>
    <Product>SignalLock</Product>
    <Company>SignalLock</Company>
    <Copyright>© 2026 SignalLock</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>embedded</DebugType>
    <Optimize>true</Optimize>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
